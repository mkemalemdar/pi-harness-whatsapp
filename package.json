{
  "name": "pi-harness-whatsapp",
  "version": "0.1.4",
  "description": "Talk to Pi from WhatsApp: images, files and optional voice notes in and out, automatic replies, group chats, poll menus to control Pi.",
  "type": "module",
  "license": "MIT",
  "author": "mkemalemdar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkemalemdar/pi-harness-whatsapp.git"
  },
  "homepage": "https://github.com/mkemalemdar/pi-harness-whatsapp#readme",
  "bugs": {
    "url": "https://github.com/mkemalemdar/pi-harness-whatsapp/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "whatsapp",
    "baileys",
    "voice",
    "whisper",
    "supertonic",
    "openvino",
    "tts",
    "speech-to-text"
  ],
  "files": [
    "src",
    "README.md",
    "AGENT_INSTALL.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://upload.wikimedia.org/wikipedia/commons/6/6b/WhatsApp.svg"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types --import ./test/setup.ts test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.2.0 <2",
    "@earendil-works/pi-coding-agent": ">=1.2.0 <2",
    "@earendil-works/pi-tui": ">=1.2.0 <2",
    "typebox": ">=1.3.0 <2"
  },
  "allowScripts": {
    "@google/genai": false,
    "baileys": false,
    "protobufjs": false
  },
  "dependencies": {
    "baileys": "^7.0.0-rc14",
    "franc": "^6.2.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "^22.20.5",
    "@types/qrcode-terminal": "^0.12.2",
    "typebox": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
